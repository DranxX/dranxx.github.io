{
  "schemaVersion": 1,
  "name": "DRX Framework",
  "version": "2.0.0",
  "mode": "static-first",
  "entrypoints": {
    "css": "drx-framework.css",
    "javascript": "js/drx.js",
    "global": "DRX",
    "initialize": "DRX.init()",
    "refresh": "DRX.refresh()",
    "diagnostics": "DRX.getDiagnostics()"
  },
  "documentation": {
    "start": "README.md",
    "usage": "docs/USAGE.md",
    "components": "docs/COMPONENT_REFERENCE.md",
    "contentPatterns": "docs/CONTENT_PATTERNS.md",
    "architecture": "docs/ARCHITECTURE.md",
    "agentRules": "AGENTS.md",
    "visualInventory": "examples/full-demo.html"
  },
  "contentPatterns": [
    { "name": "Code Block", "root": "[data-code-block]", "css": ["components/content/content.css"], "initializer": "initCodeBlocks", "events": ["drx:code-copy"] },
    { "name": "JSON View", "root": "[data-json-view]", "css": ["components/content/content.css"], "initializer": "initJsonViews", "events": ["drx:json-render", "drx:json-error", "drx:json-copy"] },
    { "name": "Terminal", "root": ".drx-terminal", "css": ["components/content/content.css"] },
    { "name": "Log Viewer", "root": ".drx-log-list", "css": ["components/content/content.css"] },
    { "name": "API Response", "root": ".drx-api-response", "css": ["components/content/content.css"] }
  ],
  "components": [
    { "name": "Questionnaire", "category": "workflow", "root": "[data-questionnaire]", "css": ["components/workflow/questionnaire.css"], "initializer": "initQuestionnaires", "events": ["drx:question-change", "drx:questionnaire-complete"] },
    { "name": "Accordion", "category": "data", "root": ".drx-accordion", "css": ["components/data/data.css"], "initializer": "initAccordion", "events": ["drx:accordion-change"] },
    { "name": "Alert", "category": "feedback", "root": ".drx-alert", "css": ["components/feedback/feedback.css"] },
    { "name": "Alert Dialog", "category": "surface", "root": "[data-alert-dialog]", "css": ["components/surface/surface.css", "components/surface/advanced.css"], "initializer": "initModals", "events": ["drx:modal-open", "drx:modal-close"] },
    { "name": "Aspect Ratio", "category": "surface", "root": ".drx-aspect", "css": ["components/surface/advanced.css"] },
    { "name": "Attachment", "category": "conversation", "root": ".drx-attachment", "css": ["components/conversation/conversation.css"] },
    { "name": "Avatar", "category": "data", "root": ".drx-avatar", "css": ["components/data/data.css"] },
    { "name": "Badge", "category": "feedback", "root": ".drx-badge", "css": ["components/feedback/feedback.css"] },
    { "name": "Breadcrumb", "category": "navigation", "root": ".drx-breadcrumb", "css": ["components/navigation/advanced.css"] },
    { "name": "Bubble", "category": "conversation", "root": ".drx-bubble", "css": ["components/conversation/conversation.css"] },
    { "name": "Button", "category": "form", "root": ".drx-btn", "css": ["components/form/form.css"] },
    { "name": "Button Group", "category": "form", "root": ".drx-btn-group", "css": ["components/form/advanced.css"] },
    { "name": "Calendar", "category": "data", "root": "[data-calendar]", "css": ["components/data/advanced.css"], "initializer": "initCalendars", "events": ["drx:date-change"] },
    { "name": "Card", "category": "surface", "root": ".drx-card", "css": ["components/surface/surface.css"] },
    { "name": "Carousel", "category": "data", "root": "[data-carousel]", "css": ["components/data/advanced.css"], "initializer": "initCarousels", "events": ["drx:carousel-change"] },
    { "name": "Chart", "category": "data", "root": ".drx-chart", "css": ["components/data/advanced.css"] },
    { "name": "Checkbox", "category": "form", "root": ".drx-checkbox", "css": ["components/form/form.css"] },
    { "name": "Collapsible", "category": "surface", "root": "[data-collapsible]", "css": ["components/surface/advanced.css"], "initializer": "initCollapsibles", "events": ["drx:collapsible-change"] },
    { "name": "Combobox", "category": "form", "root": "[data-combobox]", "css": ["components/form/advanced.css"], "initializer": "initComboboxes", "events": ["drx:select"] },
    { "name": "Command", "category": "navigation", "root": "[data-command]", "css": ["components/navigation/advanced.css"], "initializer": "initCommands", "events": ["drx:command-open", "drx:command-close", "drx:command-select"] },
    { "name": "Context Menu", "category": "navigation", "root": "[data-context-menu]", "css": ["components/navigation/advanced.css"], "initializer": "initContextMenus", "events": ["drx:context-open", "drx:context-select"] },
    { "name": "Data Table", "category": "data", "root": "[data-data-table]", "css": ["components/data/advanced.css"], "initializer": "initDataTables", "events": ["drx:table-change"] },
    { "name": "Date Picker", "category": "data", "root": "[data-date-picker]", "css": ["components/data/advanced.css"], "initializer": "initCalendars", "events": ["drx:date-change"] },
    { "name": "Dialog", "category": "surface", "root": "[data-modal-open]", "css": ["components/surface/surface.css"], "initializer": "initModals", "events": ["drx:modal-open", "drx:modal-close"] },
    { "name": "Direction", "category": "foundation", "root": "[dir]", "css": ["foundation/base.css"], "api": "setDirection", "events": ["drx:direction-change"] },
    { "name": "Drawer", "category": "surface", "root": "[data-drawer-open]", "css": ["components/surface/surface.css"], "initializer": "initDrawers", "events": ["drx:drawer-open", "drx:drawer-close"] },
    { "name": "Dropdown Menu", "category": "navigation", "root": "[data-dropdown]", "target": ".drx-menu", "css": ["components/navigation/navigation.css", "components/navigation/advanced.css"], "initializer": "initDropdowns", "events": ["drx:dropdown-open", "drx:dropdown-close"] },
    { "name": "Empty", "category": "feedback", "root": ".drx-state-empty", "css": ["components/feedback/feedback.css"] },
    { "name": "Field", "category": "form", "root": ".drx-field", "css": ["components/form/form.css", "components/form/advanced.css"] },
    { "name": "Hover Card", "category": "surface", "root": "[data-hover-card]", "target": ".drx-hover-card", "css": ["components/surface/advanced.css"], "initializer": "initHoverCards" },
    { "name": "Input", "category": "form", "root": ".drx-input", "css": ["components/form/form.css"] },
    { "name": "Input Group", "category": "form", "root": ".drx-input-group", "css": ["components/form/form.css"] },
    { "name": "Input OTP", "category": "form", "root": "[data-otp]", "css": ["components/form/advanced.css"], "initializer": "initOtp", "events": ["drx:otp-change"] },
    { "name": "Item", "category": "surface", "root": ".drx-item", "css": ["components/surface/advanced.css"] },
    { "name": "Kbd", "category": "surface", "root": ".drx-kbd", "css": ["components/surface/advanced.css"] },
    { "name": "Label", "category": "form", "root": ".drx-label", "css": ["components/form/form.css"] },
    { "name": "Marker", "category": "conversation", "root": ".drx-marker", "css": ["components/conversation/conversation.css"] },
    { "name": "Menubar", "category": "navigation", "root": "[data-menubar]", "css": ["components/navigation/advanced.css"], "initializer": "initMenubars" },
    { "name": "Message", "category": "conversation", "root": ".drx-message", "css": ["components/conversation/conversation.css"] },
    { "name": "Message Scroller", "category": "conversation", "root": "[data-message-scroller]", "css": ["components/conversation/conversation.css"], "initializer": "initMessageScrollers" },
    { "name": "Native Select", "category": "form", "root": ".drx-select", "css": ["components/form/form.css"] },
    { "name": "Navigation Menu", "category": "navigation", "root": ".drx-navbar", "css": ["components/navigation/navigation.css", "components/navigation/advanced.css"], "initializer": "initNavbar" },
    { "name": "Pagination", "category": "navigation", "root": ".drx-pagination", "css": ["components/navigation/navigation.css"] },
    { "name": "Popover", "category": "surface", "root": ".drx-popover", "trigger": "[data-dropdown]", "css": ["components/surface/surface.css", "components/navigation/advanced.css"], "initializer": "initDropdowns", "events": ["drx:dropdown-open", "drx:dropdown-close"] },
    { "name": "Progress", "category": "feedback", "root": ".drx-progress", "css": ["components/feedback/feedback.css"] },
    { "name": "Radio Group", "category": "form", "root": ".drx-radio-group", "css": ["components/form/form.css", "components/form/advanced.css"] },
    { "name": "Resizable", "category": "navigation", "root": "[data-resizable]", "css": ["components/navigation/advanced.css"], "initializer": "initResizable", "events": ["drx:resize"] },
    { "name": "Scroll Area", "category": "navigation", "root": ".drx-scroll-area", "css": ["components/navigation/advanced.css"] },
    { "name": "Select", "category": "form", "root": "[data-select]", "css": ["components/form/advanced.css"], "initializer": "initSelects", "events": ["drx:select"] },
    { "name": "Separator", "category": "surface", "root": ".drx-divider", "css": ["components/surface/surface.css"] },
    { "name": "Sheet", "category": "surface", "root": "[data-sheet-open]", "css": ["components/surface/surface.css", "components/surface/advanced.css"], "initializer": "initSheets", "events": ["drx:sheet-open", "drx:sheet-close"] },
    { "name": "Sidebar", "category": "navigation", "root": ".drx-sidebar", "css": ["components/navigation/navigation.css", "components/navigation/advanced.css"] },
    { "name": "Skeleton", "category": "feedback", "root": ".drx-skeleton", "css": ["components/feedback/feedback.css"] },
    { "name": "Slider", "category": "form", "root": "[data-slider]", "css": ["components/form/advanced.css"], "initializer": "initSliders", "events": ["drx:slider-change"] },
    { "name": "Spinner", "category": "feedback", "root": ".drx-spinner", "css": ["components/feedback/feedback.css"] },
    { "name": "Switch", "category": "form", "root": ".drx-switch", "css": ["components/form/form.css"] },
    { "name": "Table", "category": "data", "root": ".drx-table", "css": ["components/data/data.css"] },
    { "name": "Tabs", "category": "navigation", "root": ".drx-tabs", "css": ["components/navigation/navigation.css"], "initializer": "initTabs", "events": ["drx:tab-change"] },
    { "name": "Textarea", "category": "form", "root": ".drx-textarea", "css": ["components/form/form.css"] },
    { "name": "Toast", "category": "feedback", "root": ".drx-toast-container", "css": ["components/feedback/feedback.css"], "api": "toast" },
    { "name": "Toggle", "category": "form", "root": "[data-toggle]", "css": ["components/form/advanced.css"], "initializer": "initToggles", "events": ["drx:toggle-change"] },
    { "name": "Toggle Group", "category": "form", "root": "[data-toggle-group]", "css": ["components/form/advanced.css"], "initializer": "initToggles", "events": ["drx:toggle-change"] },
    { "name": "Tooltip", "category": "surface", "root": "[data-tooltip]", "css": ["components/surface/surface.css"], "initializer": "initTooltips" },
    { "name": "Typography", "category": "foundation", "root": "h1, h2, h3, p", "css": ["foundation/base.css", "foundation/typography-extras.css"] }
  ]
}
